APP_NAME=Warehouse-System
APP_ENV=production

BASE_URL=https://warehouse.example.com
FRONTEND_URL=https://warehouse.example.com

VITE_API_URL=/api
VITE_API_BASE=
VITE_PROXY_TARGET=http://backend:8000
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ORIGINS=https://warehouse.example.com,http://localhost:5173,http://127.0.0.1:5173

FRONTEND_PORT=8080
BACKEND_PORT=8001

# WICHTIG: Der DATABASE_URL MUSS auf das persistente Volume zeigen, das in
# docker-compose.yml unter `volumes: warehouse_app_data:/app/data` gemountet
# ist. Eine RELATIVE URL wie `sqlite:///./app/data/app.db` löst innerhalb des
# Containers (WORKDIR=/app) zu /app/app/data/app.db auf — also AUSSERHALB des
# Volumes — und führt zu Datenverlust beim Redeploy. Vier Slashes nach
# `sqlite:` = absoluter Pfad.
DATABASE_URL=sqlite:////app/data/app.db
DB_AUTO_CREATE_SCHEMA=true
WMS_SEED_LEGACY_ON_STARTUP=false

HARDWARE_IMPORT_PATH=/app/data/hardware_imports
BACKUP_PATH=/app/data/backups

AUTH_TOKEN_SECRET=change-me-generate-a-long-random-secret

# --- E-Mail-Versand / Registrierungsbestätigung ------------------------------
# Standardmäßig AUS — und das ist der empfohlene Startzustand:
# Ohne SMTP läuft die Registrierung im klassischen Verfahren (Benutzer
# registriert sich, Administrator gibt frei). Das funktioniert vollständig
# ohne jede E-Mail-Konfiguration.
#
# SMTP kann später bequem in der Anwendung eingerichtet werden:
#   Administration → E-Mail-Einstellungen
# Dort gespeicherte Werte haben Vorrang vor den Variablen hier. Die Variablen
# bleiben als Alternative bestehen (z. B. wenn alles aus Portainer kommen soll).
#
# WICHTIG: Der Bestätigungslink wird AUSSCHLIESSLICH aus FRONTEND_URL gebaut
# (siehe ganz oben) — niemals aus einem Request-Header. In Produktion muss
# FRONTEND_URL mit https:// beginnen, sonst wird gar nicht erst versendet.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Gehört ausschließlich in die serverlokale .env bzw. die Portainer-Stack-ENV.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Warehouse-System
# starttls (Port 587, Standard) | ssl (Port 465) | none (nur lokale Tests,
# außerhalb der Entwicklung blockiert)
SMTP_SECURITY=starttls
# Gültigkeit eines Bestätigungslinks in Stunden.
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# OPTIONAL — normalerweise leer lassen.
# Das über die Adminoberfläche gespeicherte SMTP-Passwort wird mit einem
# Schlüssel verschlüsselt, der automatisch aus AUTH_TOKEN_SECRET abgeleitet
# wird (HKDF, eigener Zweck). Ein eigener Fernet-Key hier hat Vorrang, z. B.
# um das SMTP-Passwort unabhängig vom Auth-Secret zu verwalten. Geht der
# verwendete Schlüssel verloren (oder wird AUTH_TOKEN_SECRET rotiert), muss
# das SMTP-Passwort einmalig neu eingegeben werden.
# Erzeugen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_CONFIG_ENCRYPTION_KEY=

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Admin

# --- Systemupdate (Redeploy über den Portainer-Stack-Webhook) -----------------
# Standardmäßig AUS. Ohne diese Konfiguration läuft die App völlig normal; die
# Adminseite "Systemupdate" meldet dann nur, dass die Funktion nicht aktiviert
# ist.
SYSTEM_UPDATE_ENABLED=false
# Vollständige Webhook-URL des WWS-Stacks aus Portainer. Enthält ein Token und
# gehört AUSSCHLIESSLICH in die serverlokale .env — niemals ins Repository und
# niemals ins Frontend.
PORTAINER_STACK_WEBHOOK_URL=
GITHUB_REPOSITORY=nils5002/warenwirtschaftssystem-server
GITHUB_BRANCH=main
# Optional: nur nötig für ein privates Repo oder ein höheres API-Rate-Limit.
GITHUB_API_TOKEN=
# Build-Metadaten des laufenden Stands. Rangfolge: build_info.json (aus .git
# beim Build) > vom WWS bestätigte Version (Datenbank) > diese Variablen.
# - Build MIT Git-Kontext (lokal, CI): leer lassen.
# - Portainer-Git-Stack: leer lassen. Portainer checkt ohne .git aus; der
#   Erfolg eines Updates wird über die Buildzeit belegt und der Commit danach
#   in der Datenbank geführt.
# - Deploy ohne Git-Kontext (deploy.sh via `git archive`): von Hand setzen,
#   sonst gilt die Version als unbekannt.
APP_GIT_COMMIT=
APP_GIT_BRANCH=
APP_BUILD_TIME=
# Zielversion beim Redeploy als Query-Parameter an den Portainer-Webhook
# übergeben (?APP_GIT_COMMIT=…&APP_GIT_BRANCH=…). Nur abschalten, wenn die
# Gegenstelle keine Parameter akzeptiert — dann kann das WWS den Erfolg eines
# Updates nicht mehr bestätigen.
SYSTEM_UPDATE_PASS_BUILD_METADATA=true
# Nach dieser Zeit gilt ein angestoßenes Update als abgelaufen.
SYSTEM_UPDATE_TIMEOUT_SECONDS=600
