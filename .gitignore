.venv/
backend/.venv/
frontend/node_modules/
frontend/dist/
node_modules/
dist/
build/
.vite/
__pycache__/
*.pyc

# Python-Test-/Typcheck-/Lint-Caches und Coverage (reine Werkzeug-Artefakte)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.db
*.sqlite
*.sqlite3
# SQLite-Laufzeitdateien (WAL/Shared-Memory/Rollback-Journal). Reine
# Runtime-Artefakte — duerfen nie eingecheckt werden, sonst landet
# (Teil-)Datenbankzustand im Repo.
*.db-wal
*.db-shm
*.db-journal
.env
.env.*
!.env.example
!.env*.example

# Logs / runtime artifacts
*.log
*.log.*
backend/app/data/logs/
# Lokal gecachte Produkt-/Kategoriebilder (Laufzeitdaten, nie committen)
backend/app/data/product_images/
# Hochgeladene Login-Hintergrundbilder (Laufzeitdaten, nie committen)
backend/app/data/login_backgrounds/
*.out
*.err
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/uvicorn*.log
deploy_manifest_last.txt

# Local server runtime files (must stay outside git-controlled code)
deploy/server-local/
deploy/runtime/
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.production.yml

# Secrets / credentials / certificates
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
cloudflared/

# OS / editor junk
.DS_Store
Thumbs.db
*.tmp
*.temp
*.bak
*.backup

# IDE-Zustandsdateien (per-user, nie committen)
.vscode/
.idea/

# Real hardware inventory sheets (import-only, never commit)
Hardwarebestand/*.xlsx
Hardwarebestand/*.xlsm
Hardwareplannung/

# Local-only backup files for restore/verify tests (never commit)
.local-backups/
backups/
exports/
.github
actions-runner/

# Local tooling / agent & audit artifacts (per-user, never commit)
# Damit "git add ." nicht versehentlich lokale Werkzeug-Dateien oder grosse
# Audit-Artefakte (Screenshots o. ae.) ins Repo zieht.
.claude/settings.local.json
.claude/skills/
.agents/
skills-lock.json
artifacts/

# graphify-Wissensgraph (per-user, lokal generiert, nie committen)
graphify-out/
